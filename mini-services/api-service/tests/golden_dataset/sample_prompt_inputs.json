    "samples": [
      {
        "id": "vt-001",
        "input": {
          "idea": "Алхимик варит зелья в подземной лаборатории и исследует шахты",
          "genre": "RPG",
          "aesthetics": ["Fantasy", "Discovery", "Expression"],
          "mechanics": ["Сбор ресурсов", "Крафт", "Исследование", "Торговля"]
