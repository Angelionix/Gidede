// Gidede — Prisma Schema
// Phase 4: Data-model hygiene — индексы на userId, FK-каскады для
// PlaytestResult/SavedMechanic/PrototypeGraph → Project, soft-delete для Project.
// Совместима с SQLAlchemy (оригинальный Python-бэкенд).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER — Пользователь системы
// ============================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  hashedPassword  String                   // scrypt-хеш пароля (scrypt$salt$hash)
  plan            String   @default("free") // free | pro
  aiCallsCount    Int      @default(0)      // Счётчик AI-вызовов за день
  aiCallsLimit    Int      @default(50)     // Лимит AI-вызовов (free: 50, pro: 500)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?

  projects        Project[]
  refreshTokens   RefreshToken[]
  chatMessages    ChatMessage[]
  gbeSyncHistory  GbeSyncHistory[]
  playtestResults PlaytestResult[]
  savedMechanics  SavedMechanic[]
  prototypeGraphs PrototypeGraph[]

  @@index([plan])
  @@map("users")
}

// ============================================================
// REFRESH TOKEN — Токены обновления JWT
// ============================================================

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  isRevoked  Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// PROJECT — Проект Game Design (Project State)
// ============================================================

model Project {
  id                String   @id @default(cuid())
  userId            String
  name              String
  description       String?
  genre             String?
  status            String   @default("draft") // draft | active | completed | archived
  projectStage      String?                      // concept | core_loop | mda | balance | progression | economy | gdd | validation
  completionPercent Int      @default(0)
  version           Int      @default(1)
  lastAlgorithmRun  String?
  deletedAt         DateTime?                    // soft-delete: null = active, date = archived
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept        ProjectConcept?
  coreLoop       ProjectCoreLoop?
  mdaProfile     ProjectMDAProfile?
  balanceResult  ProjectBalanceResult?
  progression    ProjectProgression?
  economy        ProjectEconomy?
  gdd            ProjectGDD?
  checklist      ProjectChecklist?
  playtestResults PlaytestResult[]
  savedMechanics  SavedMechanic[]
  prototypeGraphs PrototypeGraph[]

  @@index([userId])
  @@index([genre])
  @@index([status])
  @@index([projectStage])
  @@index([deletedAt])
  @@map("projects")
}

// ============================================================
// БЛОК 1: КОНЦЕПЦИЯ (алгоритм 3.1)
// ============================================================

model ProjectConcept {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  genre               String?
  subgenre            String?
  primaryAesthetic    String?
  usp                 String?
  inputData           String?  // JSON: ConceptInput
  onePagerData        String?  // JSON: OnePager
  aestheticProfile    String?  // JSON: AestheticProfile
  dynamicsProfile     String?  // JSON: DynamicsProfile
  mechanicSet         String?  // JSON: MechanicSet
  validationReport    String?  // JSON: ValidationReport
  uspCandidates       String?  // JSON: [{usp, triangle_check, differentiation}]
  coreLoopCandidates  String?  // JSON: [{name, steps, loop_type, fun_check}]
  // TASK-1.11: новые поля для persist ai_insights, title, generation_metadata.
  // Раньше эти данные возвращались в HTTP response, но НЕ сохранялись в БД —
  // при перезагрузке проекта они терялись.
  title               String?  // Заголовок концепции (например, "Untitled — RPG+roguelike Concept")
  aiInsights          String?  // AI-инсайты от enrichConcept (если use_ai=true)
  generationMetadata  String?  // JSON: { stages_completed, latency_ms, models_used, ai_enriched }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([genre])
  @@index([primaryAesthetic])
  @@map("project_concepts")
}

// ============================================================
// БЛОК 2: CORE LOOP (алгоритм 3.2)
// ============================================================

model ProjectCoreLoop {
  id                String   @id @default(cuid())
  projectId         String   @unique
  structuralType    String?   // Engine | Economy | Ecology | Hybrid | Tower_Defense | Rhythm | Puzzle
  structuralSubtype String?   // braked/pure, multi_currency/single, wave_based/beat_synced/pattern_based
  stepCount         Int?
  hierarchyDepth    Int?
  pathologyCount    Int       @default(0)
  inputData         String?   // JSON: CoreLoopInput
  stepsData         String?   // JSON: CoreLoopStep[]
  innerLoops        String?   // JSON: InnerLoop[]
  outerLoops        String?   // JSON: OuterLoop[]
  metaLoop          String?   // JSON: MetaLoop
  loopHierarchy     String?   // JSON: LoopHierarchy
  pathologies       String?   // JSON: PathologyReport
  recommendations   String?   // JSON: Recommendation[]
  validationData    String?   // JSON: Валидация
  fullProfile       String?   // JSON: Полный CoreLoopProfile
  // TASK-2.13: новые поля для persist
  aiInsights        String?   // AI-инсайты от enrichCoreLoop
  latencyMs         Int?      // Время генерации в мс
  modelsUsed        String?   // JSON: string[]
  garyFiveQuestions String?   // JSON: GaryFiveQuestions
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([structuralType])
  @@map("project_core_loops")
}

// ============================================================
// БЛОК 3: MDA (алгоритм 3.3)
// ============================================================

model ProjectMDAProfile {
  id                String   @id @default(cuid())
  projectId         String   @unique
  primaryAesthetic  String?
  secondaryAesthetic String?
  overallMatch      Float?
  iterationCount    Int       @default(0)
  inputData         String?   // JSON: MDAGenerationInput
  targetDynamics    String?   // JSON: DynamicsTarget
  mechanicSet       String?   // JSON: StructuredMechanicSet
  observedDynamics  String?   // JSON: string[]
  predictedAesthetics String? // JSON: Record<AestheticType, number>
  matchScores       String?   // JSON: Record<AestheticType, number>
  lensValidation    String?   // JSON: LensValidation
  bondValidation    String?   // JSON: BondValidation
  ludonarrativeCheck String?  // JSON: LudonarrativeCheck
  machinationsModel String?   // JSON: MachinationsGraph
  simulationResults String?   // JSON: Simulation results
  fullProfile       String?   // JSON: Полный MDAProfile
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([primaryAesthetic])
  @@map("project_mda_profiles")
}

// ============================================================
// БЛОК 4: БАЛАНС (алгоритм 3.4)
// ============================================================

model ProjectBalanceResult {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  balanceType        String?   // transitive | intransitive | mixed
  overallBalanceScore Float?
  imbalanceCount     Int?
  elementCount       Int?
  inputData          String?   // JSON: BalanceInput
  elements           String?   // JSON: BalancedElement[]
  costPowerCurves    String?   // JSON: CostPowerCurve[]
  intransitiveMatrix String?   // JSON: PayoffMatrix
  nashEquilibrium    String?   // JSON: NashEquilibrium
  monteCarloResults  String?   // JSON: MonteCarloResult[]
  machinationsResults String?  // JSON: Machinations
  pathologies        String?   // JSON: BalancePathology[]
  corrections        String?   // JSON: CorrectionProposal[]
  situationalValues  String?   // JSON: SituationValue matrix
  fullResult         String?   // JSON: Полный BalanceResult
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([balanceType])
  @@map("project_balance_results")
}

// ============================================================
// БЛОК 5: ПРОГРЕССИЯ (алгоритм 3.5)
// ============================================================

model ProjectProgression {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  totalLevels          Int?
  tierCount            Int?
  curveType            String?   // 7 типов кривых
  targetDurationHours  Float?
  inputData            String?   // JSON: ProgressionInput
  macroModel           String?   // JSON: ProgressionMacroModel
  tierModel            String?   // JSON: TierModel
  curves               String?   // JSON: ProgressionCurves
  contentPlan          String?   // JSON: ContentPlan
  economyLink          String?   // JSON: ProgressionEconomyLink
  validation           String?   // JSON: ProgressionValidation
  fullProfile          String?   // JSON: Полный ProgressionProfile
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([curveType])
  @@map("project_progressions")
}

// ============================================================
// БЛОК 5: ЭКОНОМИКА (алгоритм 3.6)
// ============================================================

model ProjectEconomy {
  id                String   @id @default(cuid())
  projectId         String   @unique
  systemType        String?   // Engine | Economy | Ecology
  resourceCount     Int?
  hasPathology      Boolean  @default(false)
  inputData         String?   // JSON: EconomyInput
  resourceModel     String?   // JSON: ResourceModel
  machinationsModel String?   // JSON: MachinationsGraph
  conversionChains  String?   // JSON: ConversionChain[]
  pathologies       String?   // JSON: EconomyPathology[]
  corrections       String?   // JSON: EconomyCorrection[]
  simulationResults String?   // JSON: SimulationResult
  monetizationModel String?   // JSON: MonetizationSpec
  fullProfile       String?   // JSON: Полный EconomyProfile
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([systemType])
  @@map("project_economies")
}

// ============================================================
// БЛОК 6: GDD (алгоритм 3.7)
// ============================================================

model ProjectGDD {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  format             String?   // one_sheet | ten_pager | full
  sectionCount       Int?
  completenessPercent Float?
  inputData          String?   // JSON: GDDGenerationInput
  sections           String?   // JSON: GDDSection[]
  visualElements     String?   // JSON: Record<string, VisualElement>
  consistencyIssues  String?   // JSON: ConsistencyIssue[]
  completenessReport String?   // JSON: CompletenessReport
  fullProfile        String?   // JSON: Полный GDDProfile
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([format])
  @@map("project_gdds")
}

// ============================================================
// БЛОК 6: ВАЛИДАЦИЯ (алгоритм 3.8)
// ============================================================

model ProjectChecklist {
  id                String   @id @default(cuid())
  projectId         String   @unique
  overallScore      Float?
  readinessLevel    String?   // draft | review | ready | production
  criticalIssueCount Int     @default(0)
  totalIssueCount   Int      @default(0)
  inputData         String?   // JSON: ChecklistInput
  mdaCheck          String?   // JSON: MDACheckResult
  balanceCheck      String?   // JSON: BalanceCheckResult
  narrativeCheck    String?   // JSON: NarrativeCheckResult
  economyCheck      String?   // JSON: EconomyCheckResult
  lensCheck         String?   // JSON: LensCheckResult
  issues            String?   // JSON: ValidationIssue[]
  remediationPlan   String?   // JSON: RemediationItem[]
  fullResults       String?   // JSON: Полный ChecklistResults
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([readinessLevel])
  @@map("project_checklists")
}

// ============================================================
// AI ASSISTANT — Сообщения чата (Блок 7)
// ============================================================

model ChatMessage {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?                                   // nullable — общий чат без проекта
  role       String                                     // user | assistant | system
  content    String
  metadata   String?                                    // JSON: { model_used, provider, latency_ms }
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, projectId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ============================================================
// GBE SYNC HISTORY — История синхронизации (Блок 8)
// ============================================================

model GbeSyncHistory {
  id            String   @id @default(cuid())
  userId        String
  projectId     String?
  syncDirection String                                     // to | from | webhook
  endpoint      String?
  status        String                                     // success | error
  componentsCount Int     @default(0)
  errorsCount   Int      @default(0)
  detail        String?                                    // JSON: детали
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, projectId])
  @@index([createdAt])
  @@map("gbe_sync_history")
}

// ============================================================
// PLAYTEST RESULT — Результаты тестирования прототипов кор-лупа
// ============================================================

model PlaytestResult {
  id            String   @id @default(cuid())
  userId        String
  projectId     String?
  prototypeType String                                     // engine | economy | ecology
  mode          String                                     // 2d | 3d
  outcome       String                                     // win | lose | timeout
  score         Float?
  durationSec   Float                                      // длительность плейтеста
  notes         String?
  aiGenerated   Boolean  @default(false)                   // был ли код сгенерирован AI
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, projectId])
  @@index([createdAt])
  @@index([prototypeType])
  @@map("playtest_results")
}

// ============================================================
// MECHANIC LIBRARY — Библиотека удачных механик для переиспользования
// ============================================================

model SavedMechanic {
  id              String   @id @default(cuid())
  userId          String
  projectId       String?
  mechanicName    String                                     // Название механики
  description     String                                     // Описание
  codeSnippet     String                                     // JS код
  engine          String                                     // littlejs | threejs
  coreLoopType    String?                                    // engine | economy | ecology | ...
  tags            String?                                    // JSON: массив тегов
  isPublic        Boolean  @default(false)                   // публичная или приватная
  rating          Int      @default(0)                       // рейтинг (лайки)
  createdAt       DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@index([coreLoopType])
  @@index([rating])
  @@map("saved_mechanics")
}

// ============================================================
// PROTOTYPE GRAPH — Сохранённые графы нодового редактора
// ============================================================

model PrototypeGraph {
  id            String   @id @default(cuid())
  userId        String
  projectId     String?
  name          String
  graph         String                                     // JSON NodeGraph
  generatedHtml String?                                    // скомпилированный HTML
  mode          String   @default("2d")                     // 2d | 3d
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@map("prototype_graphs")
}
