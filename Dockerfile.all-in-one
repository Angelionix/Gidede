# =============================================================================
# Gidede — All-in-One Dockerfile (Single Container)
# =============================================================================
# В одном контейнере: PostgreSQL + Redis + Backend (FastAPI) + Frontend (Next.js)
# Управление процессами через supervisord
#
# Сборка:
#   docker build -f Dockerfile.all-in-one -t gidede:all-in-one .
#
# Запуск:
#   docker run -p 3000:3000 -p 3030:3030 \
#     -e OPENAI_API_KEY=sk-... \
#     gidede:all-in-one
#
# С Docker Compose (один контейнер):
#   docker compose -f docker-compose.single.yml up
#
# Запуск тестов:
#   docker compose -f docker-compose.single.yml run --rm gidede test
#   docker compose -f docker-compose.single.yml run --rm gidede test backend
#   docker compose -f docker-compose.single.yml run --rm gidede test frontend
# =============================================================================

# ===== Stage 1: Build Frontend =====
FROM oven/bun:1 AS frontend-builder
WORKDIR /app

COPY package.json bun.lock ./
COPY prisma ./prisma/
RUN bun install --frozen-lockfile

COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN bun run db:generate
RUN bun run build

# ===== Stage 2: Build Backend Dependencies =====
FROM python:3.12-slim AS backend-deps
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev && rm -rf /var/lib/apt/lists/*

COPY mini-services/api-service/pyproject.toml ./

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    "fastapi>=0.115.0" "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.0.0" "pydantic-settings>=2.0.0" \
    "sqlalchemy[asyncio]>=2.0.0" "asyncpg>=0.30.0" \
    "aiosqlite>=0.20.0" "redis>=5.0.0" \
    "bcrypt>=4.1.0" "PyJWT>=2.8.0" \
    "httpx>=0.27.0" "openai>=1.40.0" \
    "anthropic>=0.34.0" "prometheus-client>=0.20.0" \
    "psutil>=5.9.0" "starlette>=0.40.0" \
    "python-multipart>=0.0.9" \
    "supervisor>=4.2.0" \
    && pip install --no-cache-dir .

# ===== Stage 2b: Test Dependencies =====
FROM backend-deps AS test-deps

RUN pip install --no-cache-dir \
    "pytest>=8.0.0" "pytest-asyncio>=0.23.0" \
    "pytest-cov>=5.0.0" "pytest-timeout>=2.2.0" \
    "httpx>=0.27.0" \
    "ruff>=0.4.0"

# ===== Stage 3: All-in-One Runtime =====
FROM test-deps AS runner
WORKDIR /app

# Системные зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl wget gnupg2 lsb-release \
    # PostgreSQL
    && sh -c 'echo "deb http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list' \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/postgresql.gpg \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16 postgresql-client-16 \
    # Redis
    && curl -fsSL https://packages.redis.io/gpg | gpg --dearmor -o /usr/share/keyrings/redis-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/redis-archive-keyring.gpg] https://packages.redis.io/deb $(lsb_release -cs) main" > /etc/apt/sources.list.d/redis.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends redis-server \
    # pgvector extension
    && apt-get install -y --no-install-recommends postgresql-16-pgvector \
    # Очистка
    && rm -rf /var/lib/apt/lists/*

# Python пакеты из test-deps (включает pytest и backend-deps)
COPY --from=test-deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=test-deps /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY --from=test-deps /usr/local/bin/supervisord /usr/local/bin/supervisord
COPY --from=test-deps /usr/local/bin/supervisorctl /usr/local/bin/supervisorctl
COPY --from=test-deps /usr/local/bin/pytest /usr/local/bin/pytest
COPY --from=test-deps /usr/local/bin/ruff /usr/local/bin/ruff

# Копируем Backend
COPY --chown=postgres:postgres ./mini-services/api-service /app/backend

# Копируем Frontend (standalone)
COPY --from=frontend-builder /app/.next/standalone /app/frontend
COPY --from=frontend-builder /app/.next/static /app/frontend/.next/static
COPY --from=frontend-builder /app/public /app/frontend/public
COPY --from=frontend-builder /app/prisma /app/frontend/prisma
COPY --from=frontend-builder /app/node_modules/.prisma /app/frontend/node_modules/.prisma
COPY --from=frontend-builder /app/node_modules/@prisma /app/frontend/node_modules/@prisma

# Копируем исходники frontend для тестов
COPY --from=frontend-builder /app/src /app/frontend-src/src
COPY --from=frontend-builder /app/package.json /app/frontend-src/package.json
COPY --from=frontend-builder /app/bun.lock /app/frontend-src/bun.lock
COPY --from=frontend-builder /app/vitest.config.ts /app/frontend-src/vitest.config.ts
COPY --from=frontend-builder /app/tsconfig.json /app/frontend-src/tsconfig.json
COPY --from=frontend-builder /app/node_modules /app/frontend-src/node_modules
COPY --from=frontend-builder /app/prisma /app/frontend-src/prisma

# Копируем entrypoint, supervisor config и скрипт тестов
COPY scripts/docker-entrypoint-all-in-one.sh /app/docker-entrypoint.sh
COPY scripts/docker-run-tests.sh /app/docker-run-tests.sh
COPY scripts/supervisord.conf /etc/supervisor/conf.d/gidede.conf

RUN chmod +x /app/docker-entrypoint.sh /app/docker-run-tests.sh

# Создаём директории для PostgreSQL и Redis
RUN mkdir -p /var/run/postgresql /var/run/redis /var/log/supervisor \
    && chown postgres:postgres /var/run/postgresql \
    && chown redis:redis /var/run/redis

# Переменные окружения
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV DATABASE_URL=postgresql+asyncpg://gidede:gidede_allinone@localhost:5432/gidede
ENV REDIS_URL=redis://localhost:6379/0
ENV JWT_SECRET_KEY=gidede_allinone_dev_secret_change_in_production
ENV CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
ENV NEXT_PUBLIC_API_URL=http://localhost:3030
ENV NEXTAUTH_SECRET=gidede_allinone_nextauth_secret
ENV NEXTAUTH_URL=http://localhost:3000

# Порты
EXPOSE 3000 3030

# Health check — проверяем что оба сервиса отвечают
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ && \
      python -c "import urllib.request; urllib.request.urlopen('http://localhost:3030/api/v1/health')" || exit 1

# Entrypoint: если аргумент "test" — запускаем тесты, иначе — нормальный запуск
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/usr/local/bin/supervisord", "-c", "/etc/supervisor/conf.d/gidede.conf"]
