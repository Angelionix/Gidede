# Gidede — Environment Configuration
# Database (SQLite, file-based)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# JWT secret — REQUIRED in production (≥32 chars). Server throws on boot if missing in prod.
JWT_SECRET_KEY="gidede-prod-secret-2026-please-change-this-32chars-min"

# Public API URL — empty = relative paths (recommended for same-origin deploy)
NEXT_PUBLIC_API_URL=""

# z-ai-web-dev-sdk API key — optional, AI works without it in this environment
ZAI_API_KEY=""

# Node environment
NODE_ENV="development"
