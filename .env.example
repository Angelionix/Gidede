# Gidede — Environment Variables
# Копируйте этот файл в .env и заполните значения

# === Database ===
DATABASE_URL=file:./dev.db

# PostgreSQL (для Docker Compose)
POSTGRES_URL=postgresql://gidede:gidede_dev@localhost:5432/gidede

# === Redis ===
REDIS_URL=redis://localhost:6379

# === AI APIs ===
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# === Auth ===
NEXTAUTH_SECRET=your-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# === App ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_SERVICE_PORT=3030
