# =============================================================================
# Gidede — Docker Environment Variables
# =============================================================================
# Копируйте: cp .env.docker .env
# Заполняйте API-ключи. Остальные переменные имеют дефолтные значения.
#
# Для Quick Start (docker-compose.quick.yml):
#   Достаточно задать хотя бы один AI-ключ — остальное работает из коробки.
#
# Для Single Container (docker-compose.single.yml):
#   Внутренние PostgreSQL/Redis настраиваются автоматически.
# =============================================================================

# === AI API Keys (обязательно для AI-функций) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/v1

# === Ollama (опционально — локальные модели) ===
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=llama3

# === AI Config ===
AI_DEFAULT_PROVIDER=auto
AI_CACHE_ENABLED=true

# === База данных (для quick-compose — используется автоматически) ===
# DATABASE_URL=postgresql+asyncpg://gidede:gidede_quick@postgres:5432/gidede
DB_PASSWORD=gidede_quick

# === Redis ===
# REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# === JWT (автогенерация для dev, ОБЯЗАТЕЛЬНО сменить для production!) ===
JWT_SECRET_KEY=gidede_docker_dev_secret_change_in_production_2026

# === NextAuth ===
NEXTAUTH_SECRET=gidede_nextauth_docker_secret_change_in_production
NEXTAUTH_URL=http://localhost:3000

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Режим ===
NODE_ENV=production
DEBUG=true
