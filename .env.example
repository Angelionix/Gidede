# Gidede — Переменные окружения
# Копируйте этот файл в .env и заполните значения

# === Приложение ===
NODE_ENV=development
API_SERVICE_PORT=3030

# === База данных ===
# PostgreSQL (через Docker)
DATABASE_URL=postgresql://gidede:gidede_dev@localhost:5432/gidede
# SQLite для локальной разработки (без Docker)
# DATABASE_URL=file:./gidede_dev.db
SQL_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379

# === JWT авторизация ===
JWT_SECRET_KEY=gidede_dev_secret_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === AI: z.ai (основной провайдер) ===
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/v1

# === AI: Ollama (локальные/облачные модели) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_CLOUD_MODE=false
OLLAMA_TIMEOUT=120

# === AI: OpenAI (fallback) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# === AI: Anthropic (fallback) ===
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# === AI: Общие настройки ===
AI_DEFAULT_PROVIDER=auto
AI_CACHE_ENABLED=true
AI_CACHE_DEFAULT_TTL=600

# === AI Rate Limits ===
FREE_AI_CALLS_LIMIT=50
PRO_AI_CALLS_LIMIT=500
